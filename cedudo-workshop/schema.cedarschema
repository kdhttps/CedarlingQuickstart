namespace Linux {
  entity Host;

  entity Service = {
    critical: Bool,
    environment: String
  };

  entity User = {
    gid: Long,
    groups: Set<String>,
    home: String,
    shell: String,
    uid: Long
  };

  entity test;

  action "OpenShell" appliesTo {
    principal: [User],
    resource: [Host],
    context: {
      current_time: Long,
      hostname: String,
      interactive: Bool,
      local_console: Bool
    }
  };

  action "ReadLogs" appliesTo {
    principal: [User],
    resource: [Service],
    context: {
      current_time: Long,
      hostname: String,
      interactive: Bool,
      local_console: Bool
    }
  };

  action "Restart" appliesTo {
    principal: [User],
    resource: [Service],
    context: {
      current_time: Long,
      hostname: String,
      interactive: Bool,
      local_console: Bool
    }
  };

  action "ViewStatus" appliesTo {
    principal: [User],
    resource: [Service],
    context: {
      current_time: Long,
      hostname: String,
      interactive: Bool,
      local_console: Bool
    }
  };
}
